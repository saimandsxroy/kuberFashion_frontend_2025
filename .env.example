# ==============================================================================
# KuberFashion Frontend — Environment Configuration Template (.env.example)
# Copy to .env for local development or .env.staging for staging builds.
# Never put secret keys (such as service role keys or database credentials) here.
# ==============================================================================

# Backend API Configuration
# Local dev: http://localhost:8080/api
# Production: https://kuberfashion-backend-2025.onrender.com/api
VITE_API_BASE_URL=https://kuberfashion-backend-2025.onrender.com/api
VITE_API_TIMEOUT=10000

# Supabase Auth & Storage (Client-Safe Anonymous Key Only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Application Metadata
VITE_APP_NAME=KuberFashion
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Modern E-commerce Fashion Store

# WhatsApp Integration
VITE_WHATSAPP_NUMBER=919179193970
VITE_WHATSAPP_DEFAULT_MESSAGE=Hi! I have a question about KuberFashion.

# Fallback UI Assets
VITE_DEFAULT_PRODUCT_IMAGE=https://images.unsplash.com/photo-1441986300917-64674bd600d8
